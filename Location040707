// マーカー全削除
function clearMarkers() {
    // 確認ダイアログ
    if (!confirm('全ての位置データとカップイン記録を削除します。よろしいですか？')) {
        return;
    }
    
    // 各人物のマーカーを削除
    for (const person in locationData) {
        locationData[person].forEach(item => {
            if (item.marker) {
                item.marker.setMap(null);
            }
        });
        locationData[person] = [];
    }
    
    // カップインデータの記録もクリア（含まれるマーカーも削除）
    for (const person in cupInData) {
        cupInData[person].forEach(hole => {
            // ホールの各ショットのマーカーも削除（shots配列があれば）
            if (hole.shots) {
                hole.shots.forEach(shot => {
                    if (shot.marker) {
                        shot.marker.setMap(null);
                    }
                });
            }
        });
        cupInData[person] = [];
    }
    
    // カップ位置マーカーの削除
    cupPositions.forEach(cup => {
        if (cup.marker) {
            cup.marker.setMap(null);
        }
    });
    cupPositions = [];
    
    // Tee位置マーカーの削除
    teePositions.forEach(tee => {
        if (tee.marker) {
            tee.marker.setMap(null);
        }
    });
    teePositions = [];
    
    // 現在地マーカーも削除
    if (currentMarker) {
        currentMarker.setMap(null);
        currentMarker = null;
    }
    
    // 打球ラインの削除
    for (const person in shotLines) {
        if (shotLines[person]) {
            shotLines[person].setMap(null);
            shotLines[person] = null;
        }
    }
    
    // テーブル更新
    updateLocationList();
    showStatus('全ての位置データとカップイン記録を削除しました', '#555');
}

// カップイン記録
function recordCupIn() {
    const personData = locationData[currentPerson];
    
    // 位置記録がない場合はエラー
    if (personData.length === 0) {
        showStatus(`${getPerson(currentPerson)}の位置記録がありません`, '#F44336');
        return;
    }
    
    // 現在のホール番号を取得（設定画面で選択したもの）
    const holeNumber = currentHole;
    
    // カップイン時には最後の打数の後に+1打を加える（要件１）
    const strokeCount = personData.length + 1;
    
    // 最後の打球位置を取得
    const lastLat = personData[personData.length-1].lat;
    const lastLng = personData[personData.length-1].lng;
    const timestamp = new Date();
    
    // このホールのショットデータを深いコピーで作成
    const currentShots = JSON.parse(JSON.stringify(
        personData.map(item => ({
            num: item.num,
            lat: item.lat,
            lng: item.lng,
            timestamp: new Date(item.timestamp)
        }))
    ));
    
    // カップインデータを記録
    cupInData[currentPerson].push({
        holeNumber: holeNumber,
        strokeCount: strokeCount,  // +1 された打数で記録
        timestamp: timestamp,
        lat: lastLat,
        lng: lastLng,
        shots: currentShots
    });
    
    // 最後のマーカーをカップインマーカーに変更
    const lastMarker = personData[personData.length - 1].marker;
    
    // マーカーの見た目を変更（黄色い星マークなど）
    lastMarker.setIcon({
        path: google.maps.SymbolPath.CIRCLE,
        fillColor: "#FFD700", // 金色
        fillOpacity: 1,
        strokeColor: "#FF9800",
        strokeWeight: 3,
        scale: 15
    });
    
    // ステータス表示
    showStatus(`${getPerson(currentPerson)}のホール${holeNumber}が${strokeCount}打でカップインしました`, '#FF9800');
    
    // 情報ウィンドウを更新
    const infoContent = `
        <div style="text-align: center;">
            <strong>${getPerson(currentPerson)} #${personData.length}</strong><br>
            <span style="color: #FF9800; font-weight: bold;">ホール${holeNumber}: ${strokeCount}打でカップイン</span><br>
            <small>(最後の打球 + カップインの1打)</small><br>
            緯度: ${lastLat.toFixed(6)}<br>
            経度: ${lastLng.toFixed(6)}<br>
            時刻: ${formatTime(timestamp)}
        </div>
    `;
    
    const infoWindow = new google.maps.InfoWindow({
        content: infoContent
    });
    
    infoWindow.open(map, lastMarker);
    
    // テーブル更新（カップイン情報を含める）
    updateLocationList();
    
    // 打球ラインを更新
    updateShotLines();
    
    // 現在のホールの打球データをクリア（すでにカップインしたため）
    locationData[currentPerson] = [];
}

// CSVエクスポート
function exportCSV() {
    // 全データを収集するための配列
    let allData = [];
    
    // 現在進行中の各プレーヤーのデータを収集
    for (const person of ['a', 'b', 'c']) {
        // 現在のホール番号を使用
        const holeNumber = currentHole;
        
        locationData[person].forEach(item => {
            allData.push({
                type: 'shot',
                name: getPerson(person),
                num: item.num,
                lat: item.lat,
                lng: item.lng,
                timestamp: item.timestamp,
                hole: holeNumber,
                strokeInfo: `ホール${holeNumber}: ${item.num}打目`
            });
        });
    }
    
    // 完了したホールのデータ（カップインとすべての打球）を追加
    for (const person of ['a', 'b', 'c']) {
        // この人の完了したホールのデータ
        cupInData[person].forEach(hole => {
            // カップイン情報
            allData.push({
                type: 'cupin',
                name: getPerson(person),
                num: 'カップイン',
                lat: hole.lat || 0,
                lng: hole.lng || 0,
                timestamp: hole.timestamp,
                hole: hole.holeNumber,
                strokeInfo: `ホール${hole.holeNumber}: ${hole.strokeCount}打`
            });
            
            // 各ホールの打球データがあれば追加
            if (hole.shots) {
                hole.shots.forEach(shot => {
                    allData.push({
                        type: 'past_shot',
                        name: getPerson(person),
                        num: shot.num,
                        lat: shot.lat,
                        lng: shot.lng,
                        timestamp: shot.timestamp,
                        hole: hole.holeNumber,
                        strokeInfo: `ホール${hole.holeNumber}: ${shot.num}/${hole.strokeCount}打`
                    });
                });
            }
        });
    }
    
    // カップ位置データも追加
    cupPositions.forEach(cup => {
        allData.push({
            type: 'cup_position',
            name: 'カップ位置',
            num: cup.holeNumber,
            lat: cup.lat,
            lng: cup.lng,
            timestamp: cup.timestamp,
            hole: cup.holeNumber,
            strokeInfo: `ホール${cup.holeNumber}のカップ位置`
        });
    });
    
    // Tee位置データも追加
    teePositions.forEach(tee => {
        allData.push({
            type: 'tee_position',
            name: 'Tee位置',
            num: tee.holeNumber,
            lat: tee.lat,
            lng: tee.lng,
            timestamp: tee.timestamp,
            hole: tee.holeNumber,
            strokeInfo: `ホール${tee.holeNumber}のTee位置`
        });
    });
    
    // 空配列チェック
    if (allData.length === 0) {
        showStatus('エクスポートするデータがありません', '#F44336');
        return;
    }
    
    // 時間順にソート
    allData.sort((a, b) => a.timestamp - b.timestamp);
    
    // CSVデータ作成
    let csvContent = "名前,タイプ,番号,緯度,経度,時刻,ホール,打数情報\n";
    
    allData.forEach(item => {
        let typeText = "";
        switch(item.type) {
            case 'shot': typeText = "打球"; break;
            case 'past_shot': typeText = "過去の打球"; break;
            case 'cupin': typeText = "カップイン"; break;
            case 'cup_position': typeText = "カップ位置"; break;
            case 'tee_position': typeText = "Tee位置"; break;
            default: typeText = item.type;
        }
        
        csvContent += `${item.name},${typeText},${item.num},${item.lat.toFixed(6)},${item.lng.toFixed(6)},`;
        csvContent += `${formatTime(item.timestamp)},${item.hole},${item.strokeInfo}\n`;
    });
    
    try {
        // ダウンロード処理
        const encodedUri = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', '位置データ.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        
        showStatus('CSVファイルをダウンロードしました', '#4CAF50');
    } catch (error) {
        console.error('CSVエクスポートエラー:', error);
        showStatus('CSVエクスポートに失敗しました: ' + error.message, '#F44336');
    }
}

// ユーティリティ関数
function getPerson(person) {
    return personNames[person];
}

function getPersonColor(person) {
    return person === 'a' ? '#4CAF50' : person === 'b' ? '#2196F3' : '#F44336';
}

function formatTime(date) {
    return date.toLocaleString('ja-JP', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
    });
}

function showStatus(message, color) {
    const statusElement = document.getElementById('status');
    statusElement.textContent = message;
    statusElement.style.backgroundColor = color ? color + '22' : '#f0f0f0'; // 半透明の背景色
    statusElement.style.color = color ? color : '#333';
    statusElement.style.borderLeft = `4px solid ${color || '#333'}`;
    // 一定時間後に背景色をフェードアウト
    setTimeout(() => {
        statusElement.style.transition = 'background-color 1s ease';
        statusElement.style.backgroundColor = 'transparent';
    }, 3000);
}

// 航空写真表示の切り替え
function toggleSatelliteView() {
    isInSatelliteView = !isInSatelliteView;
    if (isInSatelliteView) {
        map.setMapTypeId(google.maps.MapTypeId.SATELLITE);
        showStatus("航空写真表示に切り替えました", "#555");
    } else {
        map.setMapTypeId(google.maps.MapTypeId.ROADMAP);
        showStatus("地図表示に切り替えました", "#555");
    }
}

// 拡大表示
function zoomInView() {
    const currentZoom = map.getZoom();
    const newZoom = Math.min(currentZoom + 2, 20); // 最大ズームレベル20
    map.setZoom(newZoom);
    showStatus(`拡大表示: ズームレベル ${newZoom}`, "#555");
}

// マップビューをリセット
function resetMapView() {
    // 標準マップに戻す
    map.setMapTypeId(google.maps.MapTypeId.ROADMAP);
    isInSatelliteView = false;
    
    // ズームレベルを元に戻す
    map.setZoom(13);
    
    // 石坂ゴルフクラブの座標に戻す
    map.setCenter({ lat: 35.994686, lng: 139.365139 });
    
    showStatus("マップを標準表示に戻しました", "#555");
}

// 打球ラインを更新する関数
function updateShotLines() {
    // 現在のホール番号
    const holeNumber = currentHole;
    
    // まず既存のラインを削除
    for (const person in shotLines) {
        if (shotLines[person]) {
            shotLines[person].setMap(null);
            shotLines[person] = null;
        }
    }
    
    // 各プレイヤーについて処理
    for (const person of ['a', 'b', 'c']) {
        const personColor = getPersonColor(person);
        const currentShots = locationData[person];
        
        // プレイヤーのデータがない場合は、過去のホールのデータを探す
        if (currentShots.length === 0) {
            // 過去のデータから現在のホールのデータを探す
            const completedHoleData = cupInData[person].find(hole => hole.holeNumber === holeNumber);
            
            if (completedHoleData && completedHoleData.shots && completedHoleData.shots.length > 0) {
                // ショットの位置を収集
                const path = [];
                
                // Tee位置があれば追加
                const teePosition = teePositions.find(tee => tee.holeNumber === holeNumber);
                if (teePosition) {
                    path.push({ lat: teePosition.lat, lng: teePosition.lng });
                }
                
                // ショットを順番に追加 (カップインした場合はカップも含める)
                completedHoleData.shots.forEach(shot => {
                    path.push({ lat: shot.lat, lng: shot.lng });
                });
                
                // カップインしたホールならカップ位置も追加
                const cupPosition = cupPositions.find(cup => cup.holeNumber === holeNumber);
                if (cupPosition) {
                    path.push({ lat: cupPosition.lat, lng: cupPosition.lng });
                }
                
                // 2点以上あればラインを描画
                if (path.length >= 2) {
                    shotLines[person] = new google.maps.Polyline({
                        path: path,
                        geodesic: true,
                        strokeColor: personColor,
                        strokeOpacity: 0.8,
                        strokeWeight: 3
                    });
                    
                    shotLines[person].setMap(map);
                }
            }
        } else {
            // 現在進行中のショットがある場合
            // ショットの位置を収集
            const path = [];
            
            // Tee位置があれば追加
            const teePosition = teePositions.find(tee => tee.holeNumber === holeNumber);
            if (teePosition) {
                path.push({ lat: teePosition.lat, lng: teePosition.lng });
            }
            
            // ショットを順番に追加
            currentShots.forEach(shot => {
                path.push({ lat: shot.lat, lng: shot.lng });
            });
            
            // カップは追加しない（カップインしていないため）
            
            // 2点以上あればラインを描画
            if (path.length >= 2) {
                shotLines[person] = new google.maps.Polyline({
                    path: path,
                    geodesic: true,
                    strokeColor: personColor,
                    strokeOpacity: 0.8,
                    strokeWeight: 3
                });
                
                shotLines[person].setMap(map);
            }
        }
    }
}

